<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linsolve.illustrated.fabrics.FabricsController"
      spacing="15" prefWidth="1150" prefHeight="750" styleClass="main-container">
    
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>
    
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header-bar">
        <Label text="Fabrics and Fall Fashions" styleClass="header-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="solveButton" text="Solve Optimization" onAction="#handleSolve" styleClass="primary-btn"/>
    </HBox>
    
    <SplitPane dividerPositions="0.35" VBox.vgrow="ALWAYS">
        <!-- Left: Parameters -->
        <VBox spacing="15" styleClass="card">
            <Label text="Model Configuration" styleClass="section-title"/>
            
            <TitledPane text="Material Constraints (Upper Bounds)" expanded="true">
                <GridPane fx:id="materialGrid" hgap="10" vgap="10"/>
            </TitledPane>
            
            <TitledPane text="Demand Constraints (Min Production)" expanded="true">
                <GridPane fx:id="demandGrid" hgap="10" vgap="10"/>
            </TitledPane>
            
            <Region VBox.vgrow="ALWAYS"/>
            <ProgressBar fx:id="progressBar" prefWidth="10000.0" progress="0"/>
            <Label fx:id="statusLabel" text="Ready." styleClass="status-text"/>
        </VBox>
        
        <!-- Right: Results -->
        <VBox spacing="15" styleClass="card">
            <Label text="Optimization Results" styleClass="section-title"/>
            
            <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="itemColumn" text="Clothing Item" prefWidth="220"/>
                    <TableColumn fx:id="quantityColumn" text="Quantity Produced" prefWidth="150"/>
                    <TableColumn fx:id="profitColumn" text="Total Profit" prefWidth="150"/>
                </columns>
            </TableView>
            
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Total Profit:" styleClass="sub-title"/>
                    <Label fx:id="totalProfitLabel" text="" styleClass="profit-highlight"/>
                </VBox>
            </HBox>
            
            <TextArea fx:id="detailsArea" prefHeight="100" editable="false" styleClass="console-text"/>
        </VBox>
    </SplitPane>
</VBox>